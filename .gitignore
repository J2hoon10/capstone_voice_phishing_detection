!**/.gitkeep

# ── STT 전사 데이터 (실제 통화 내용 포함 — 민감 데이터) ──────────────────────
models/main/data_augmentation/transcriptions/
models/main/data_augmentation/error_analysis/*.csv
models/main/data_augmentation/error_analysis/*.json

# ── 데이터 분석 산출물 (CSV/JSON — 전사 내용 포함 가능) ───────────────────────
data_analysis/output/*.csv
data_analysis/output/*.json

# ── Experiment data folders ──────────────────────────────────────────────────
models/classifier/experiments/*/data/
models/classifier/experiments/mamba_belief/data/

# ── Env ──────────────────────────────────────────────────────────────────────
.env

# ── Docs (내부 계획 / 역할 가이드 / 아카이브) ──────────────────────────────
docs/archive/
docs/plans/
docs/reports/
docs/api_spec.md
docs/deployment_guide.md
docs/GETTING_STARTED.md
docs/GIT_DATA_TRACKING_ISSUE.md
docs/ROLE_CLASSIFIER.md
docs/ROLE_GUIDANCE.md

# ── Experiment checkpoints & logs (figures 폴더 제외) ────────────────────────
models/experiments/model_architecture/*/checkpoints/
models/experiments/model_architecture/*/logs/

# ── Main model architecture artifacts ────────────────────────────────────────
models/main/model_architecture/checkpoints/
models/main/model_architecture/logs/

