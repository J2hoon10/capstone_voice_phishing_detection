!**/*_eval.json
!**/*_latest.json

# ── Raw datasets ─────────────────────────────────────────────────────────────
Data/
normal_data_reference/*/

# ── Preprocessed / augmented data ────────────────────────────────────────────
models/main/model_architecture/data/
models/classifier/preprocessing/output/
models/classifier/preprocessing/legacy_v1/output/
models/classifier/preprocessing/normal_augmentation/output/
models/classifier/preprocessing/stn_labeling/output/
