*.pth
*.ckpt
*.safetensors
*.onnx
*.pb
*.h5
*.model
*.weights
*.bin
*.zip
!models/classifier/weights/.gitkeep

# ── Audio files ─────────────────────────────────────────────────────────────
*.wav
*.mp3
*.flac
*.m4a
*.ogg

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.venv/

# ── Frontend ─────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
demo/node_modules/
demo/dist/

# ── Training logs ────────────────────────────────────────────────────────────
runs/
tb_logs/
wandb/
*.log
*_train.json
