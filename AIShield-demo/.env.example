# Shared service URLs (used by backend)
CLASSIFIER_URL=http://classifier:8001
GUIDANCE_URL=http://guidance:8002

# Classifier runtime
CLASSIFIER_DEVICE=cpu
CLASSIFIER_MODEL_KIND=roberta_mamba_4class
ROBERTA_MAMBA_MODEL_PATH=/app/checkpoints/roberta_mamba_freeze_init_4class_4class_20260517_174922_best.pt
WHISPER_MODEL_SIZE=Systran/faster-whisper-base
DEFAULT_THRESHOLD=0.5
REALTIME_STT_WINDOW_SECONDS=20
REALTIME_STT_STRIDE_SECONDS=10
REALTIME_MODEL_POLL_SECONDS=0.5

# Backend
CORS_ORIGINS=*
CLASSIFIER_TIMEOUT=180
GUIDANCE_TIMEOUT=30

# Frontend publish port
FRONTEND_PORT=80
